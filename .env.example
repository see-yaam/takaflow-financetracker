# Supabase (required for frontend)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# Optional: local Supabase CLI / server-side references
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# NOTE: never put AI provider keys in a VITE_* variable — anything prefixed
# VITE_ is compiled into the public JS bundle and every APK.

# Edge Function secrets (set with `supabase secrets set` or in the Supabase
# dashboard -> Edge Functions -> Secrets; NOT in the frontend)
SUPABASE_SERVICE_ROLE_KEY=
LOVABLE_API_KEY=
GEMINI_API_KEY=
RESEND_API_KEY=
# Verified Resend sender, e.g. "TakaFlow <no-reply@yourdomain.com>"
RESEND_FROM=
# Base URL used in password-reset links
APP_URL=https://takaflow-financetracker.vercel.app
ALLOWED_ORIGIN=https://takaflow-financetracker.vercel.app
